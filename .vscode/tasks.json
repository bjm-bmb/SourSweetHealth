{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "app-agent: sync latest harness on folder open",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\tools\\harness_update.ps1",
        "-Quiet"
      ],
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true, "showReuseMessage": false },
      "problemMatcher": []
    }
  ]
}
