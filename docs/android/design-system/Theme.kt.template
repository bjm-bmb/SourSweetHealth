package {{package}}.ui.theme

import androidx.compose.foundation.isSystemInDarkTheme
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.Shapes
import androidx.compose.material3.Typography
import androidx.compose.material3.darkColorScheme
import androidx.compose.material3.lightColorScheme
import androidx.compose.runtime.Composable
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.text.TextStyle
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp

// ---- 色彩（默认值取自默认品牌 VI 单色方案：主色即近黑；接入品牌后改读 BrandColors） ----

private val LightColorScheme = lightColorScheme(
    primary = Color(0xFF1A1A1A),
    onPrimary = Color(0xFFFFFFFF),
    background = Color(0xFFFAFAF9),
    onBackground = Color(0xFF1A1A1A),
    surface = Color(0xFFFFFFFF),
    onSurface = Color(0xFF1A1A1A),
    surfaceVariant = Color(0xFFF0EFEC),
    onSurfaceVariant = Color(0xFF6E7377),
    outline = Color(0xFFE3E1DD),
    error = Color(0xFFB05C5C),
    onError = Color(0xFFFFFFFF),
)

private val DarkColorScheme = darkColorScheme(
    primary = Color(0xFFECEDEE),
    onPrimary = Color(0xFF1A1A1A),
    background = Color(0xFF16181A),
    onBackground = Color(0xFFECEDEE),
    surface = Color(0xFF1E2124),
    onSurface = Color(0xFFECEDEE),
    surfaceVariant = Color(0xFF2A2E33),
    onSurfaceVariant = Color(0xFF9BA0A5),
    outline = Color(0xFF33373B),
    error = Color(0xFFC77B7B),
    onError = Color(0xFF1A1A1A),
)

// ---- 字阶（6 级，对应 ui-design-guide §三，不新增级别） ----

private val AppTypography = Typography(
    displaySmall = TextStyle(fontSize = 32.sp, fontWeight = FontWeight.Medium, lineHeight = 40.sp),
    headlineSmall = TextStyle(fontSize = 22.sp, fontWeight = FontWeight.Medium, lineHeight = 30.sp),
    titleMedium = TextStyle(fontSize = 17.sp, fontWeight = FontWeight.Medium, lineHeight = 24.sp),
    bodyLarge = TextStyle(fontSize = 15.sp, fontWeight = FontWeight.Normal, lineHeight = 24.sp),
    bodySmall = TextStyle(fontSize = 13.sp, fontWeight = FontWeight.Normal, lineHeight = 20.sp),
    labelSmall = TextStyle(fontSize = 11.sp, fontWeight = FontWeight.Medium, lineHeight = 16.sp),
)

// ---- 圆角（8/12/16 统一体系） ----

private val AppShapes = Shapes(
    small = RoundedCornerShape(8.dp),
    medium = RoundedCornerShape(12.dp),
    large = RoundedCornerShape(16.dp),
)

// ---- 间距（4dp 网格，组件与界面只引用语义名） ----

object Spacing {
    val hairline = 2.dp // 仅细分隔线与细线进度
    val xs = 4.dp
    val sm = 8.dp
    val md = 12.dp
    val lg = 16.dp
    val xl = 20.dp
    val xxl = 24.dp
    val xxxl = 32.dp
    val pagePadding = 20.dp
    val listItemMinHeight = 56.dp
    val buttonHeight = 48.dp
    val touchTargetMin = 48.dp
}

// ---- 主题挂载 ----

@Composable
fun AppTheme(
    darkTheme: Boolean = isSystemInDarkTheme(),
    content: @Composable () -> Unit,
) {
    MaterialTheme(
        colorScheme = if (darkTheme) DarkColorScheme else LightColorScheme,
        typography = AppTypography,
        shapes = AppShapes,
        content = content,
    )
}
