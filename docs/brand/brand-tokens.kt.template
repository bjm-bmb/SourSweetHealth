    val hairline = 2.dp  // 仅细分隔线与细线进度
    val xs = 4.dp
    val sm = 8.dp
    val md = 12.dp
    val lg = 16.dp
    val xl = 20.dp
    val xxl = 24.dp
    val xxxl = 32.dp
    val pagePadding = 20.dp
    val listItemMinHeight = 56.dp
